# Large or regenerable outputs of the rerun of 2-3 Nov 2026.  Everything here is regenerated by
# campaign.py; the per-stage summaries are in done/*.json, REPORT.md and campaign.log.
__pycache__/
/bin/
# core classes (lattice lists, canonical forms, fast-filter verdicts and deferred lists); the heavy
# configurations *_heavy.g6 and the invariants are kept
/cores/*.jsonl
/cores/*.g6
!/cores/*_heavy.g6
/cores/*_ff_*.out
# second enumerator: lattice lists
/indep/lattices_*.jsonl
# Macaulay2 records of the deferred cores (shards and per-class files)
/comp/comp_*.jsonl
/comp/defer_all.jsonl
# extension: children lists, worker inputs, children verdicts and deferred lists
/ext/*_ch.jsonl
/ext/*_r[0-9].jsonl
/ext/*_chcomp_*.jsonl
/ext/*defer*.jsonl
/ext/*_ff_*.out
# numeric rigid search: worker inputs
/indep_rigid/in_*.jsonl
# Anghel-Stan verdicts per lattice (summaries in as/compare_*.json)
/as/*.status
# lattices without an 8-point line: the union and the two largest vectors (as in work/n17/audit)
/n8zero/n8_all.jsonl
/n8zero/p5c_*.jsonl
