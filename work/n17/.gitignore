# Not committed: compiled programs, Macaulay2 scripts generated by the Python drivers, debugging
# leftovers, and the large or regenerable intermediates of the 17-line proof.  Every ignored data file
# is listed with its size, line count and SHA-256 in manifest_excluded.tsv; MANIFEST.md says how each
# kind is regenerated.
__pycache__/
/heavy/heavyaug_k
/heavy/heavyaug_p
/heavy/heavyaug_w
/heavy/lsgen3
/heavy/lsgen3p
/cover/n8core
/cover/phicore
/cover/phistat
*.jsonl.*.m2
*.out.*.m2
/comp/dbg.*
/run/dbg*.m2
/run/pmdbg.m2
# raw enumerations and the lists of 13-line cores (heavy/, cores/g6tojsonl.py)
/heavy/*_raw.g6
/heavy/core48_canon.g6
/heavy/res0.g6
/heavy/res0_s5k_leaves.g6
/heavy/samp20k.g6
/heavy/sample_r7.g6
/cores/core4[89].*
/cores50/core5[01].g6
/cores50/core5[01].jsonl
/n8zero/p5b_4[34]3[33][23].jsonl
# fast-filter verdicts and deferred lists of cores and children (full_recheck.py, runclass.py); every
# deferred lattice is contained in its Macaulay2 record in results/
/cores/c4[89]_p[0-9].out
/cores/*defer*.jsonl
/cores50/c5[01]_p[0-9].out
/cores50/*_defer.jsonl
/comp/d4[89].jsonl
/comp/d50.jsonl
/comp/dall.jsonl
/comp/dall_tagged.jsonl
/comp/d51_tagged.jsonl
/run/*_ff.out
/run/*_ff_[0-9].out
/run/*defer*.jsonl
# Macaulay2 component records of cores and children: concatenated in results/*.jsonl.gz
/comp/dall_comp_*.jsonl
/comp/dallb_comp_*.jsonl
/comp/d51_comp_*.jsonl
/comp/d51b_comp_*.jsonl
/run/*_chcomp_*.jsonl
/run/dim2_b4849_ch_comp_*.jsonl
/run/d2c2_comp_*.jsonl
/run/comp_b*.jsonl
# children lists and the record files handed to the rigid / family / lattice-level workers
/run/*_ch.jsonl
/run/*_r[0-9].jsonl
/run/rerun/r_*.jsonl
!/run/rerun/r_*_ext.jsonl
/run/d2c_rigid.jsonl
